<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeDeveloperAdvertising</string>
			</array>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
		</dict>
	</array>
	<!-- No NSPrivacyTracking and no NSPrivacyTrackingDomains, on purpose. Apple TN3181 lists
	     "NSPrivacyTracking true with an empty NSPrivacyTrackingDomains" as an INVALID manifest
	     (the shape this file carried until 2026-09-15), and gives the shape for an SDK that
	     connects to no tracking domain of its own: remove both keys. This module cannot name a
	     domain because the host configures the ingest endpoint at runtime, and naming attrikit.io
	     would make iOS block every request to it, including erasure, for users who decline ATT
	     (shipped in 2.2.0, reverted in 2.2.1). The DeviceID entry above keeps its tracking flag;
	     the HOST app declares NSPrivacyTracking and its own ingest domain. -->
</dict>
</plist>
